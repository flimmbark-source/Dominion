{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devcontainer.json",
  "name": "Dominion",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "postCreateCommand": "bash -lc 'sudo apt-get update && sudo apt-get install -y xvfb && python -m venv .venv && source .venv/bin/activate && pip install -r requirements.txt'",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
