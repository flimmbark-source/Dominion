// File: .devcontainer/devcontainer.json
{
  "name": "Grimm Dominion (Fast Codespaces)",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "features": {},
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "terminal.integrated.shellIntegration.enabled": true
      }
    }
  },
  "mounts": [
    "type=cache,target=/root/.cache/pip"
  ],
  "updateContentCommand": "",          // nothing on open (already baked in)
  "postCreateCommand": "",             // keep empty for zero-delay first open
  "postStartCommand": "",              // optionally: "make web"
  "remoteUser": "vscode"               // default user in devcontainers image
}
